@page
@model IndexModel
@{
    ViewData["Title"] = "Supply Requests";
}

<h1>Clinic Supply Tracker</h1>

<a asp-page="/Create" class="btn btn-primary mb-3">
    New request
</a>

<div class="mb-3">
    <a asp-page="/Index" class="btn btn-outline-secondary">
        All
    </a>

    <a asp-page="/Index"
       asp-route-status="pending"
       class="btn btn-outline-secondary">
        Pending
    </a>

    <a asp-page="/Index"
       asp-route-status="fulfilled"
       class="btn btn-outline-secondary">
        Fulfilled
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Quantity</th>
            <th>Department</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.Requests)
        {
            <tr>
                <td>@request.ItemName</td>
                <td>@request.Quantity</td>
                <td>@request.Department</td>
                <td>@(request.IsFulfilled ? "Fulfilled" : "Pending")</td>
                <td>
                    <a asp-page="/Edit"
                        asp-route-id="@request.Id"
                        class="btn btn-outline-primary btn-sm">
                        Edit
                    </a>

                    <a asp-page="/Delete"
                        asp-route-id="@request.Id"
                        class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>

                    @if (!request.IsFulfilled)
                    {
                        <form method="post"
                            asp-page-handler="Fulfill"
                            asp-route-id="@request.Id">
                            <button type="submit" class="btn btn-success btn-sm">
                                Mark fulfilled
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>