@page "{id:int}"
@model ClinicSupplyTracker.Pages.EditModel
@{
    ViewData["Title"] = "Edit Request";
}

<h1>Edit Supply Request</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EditedRequest.ItemName">Item name</label>
        <input asp-for="EditedRequest.ItemName"
               class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="EditedRequest.Quantity">Quantity</label>
        <input asp-for="EditedRequest.Quantity"
               class="form-control" min="1" required />
    </div>

    <div class="mb-3">
        <label asp-for="EditedRequest.Department">Department</label>
        <input asp-for="EditedRequest.Department"
               class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">
        Save changes
    </button>

    <a asp-page="/Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>