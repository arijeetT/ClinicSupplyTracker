@page "{id:int}"
@model ClinicSupplyTracker.Pages.DeleteModel
@{
    ViewData["Title"] = "Delete Request";
}

<h1>Delete Supply Request</h1>

<p>Are you sure you want to delete this request?</p>

<dl>
    <dt>Item</dt>
    <dd>@Model.RequestItem.ItemName</dd>

    <dt>Quantity</dt>
    <dd>@Model.RequestItem.Quantity</dd>

    <dt>Department</dt>
    <dd>@Model.RequestItem.Department</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">
        Delete request
    </button>

    <a asp-page="/Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>